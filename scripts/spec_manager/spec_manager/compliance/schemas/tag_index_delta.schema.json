{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TagIndexDelta",
  "description": "Agent output for tagging. Uses local_id for new items; system resolves to stable IDs (CON-0019).",
  "type": "object",
  "required": ["items", "relations"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["local_id", "kind", "title", "evidence_atom_ids"],
        "properties": {
          "local_id": {
            "type": "string",
            "description": "Agent-assigned temporary ID (e.g., 'new-1', 'new-2'). System will allocate stable elem_id."
          },
          "existing_elem_id": {
            "type": "string",
            "description": "If referencing an existing element, provide its stable ID here. local_id still required for relation references."
          },
          "kind": {
            "type": "string",
            "enum": ["REQ", "FLOW", "INV", "DEC", "ALG", "DS", "NOTE", "GAP", "ENT"]
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "evidence_atom_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ATOM-"
            },
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_local_id", "to_local_id", "relation_type"],
        "properties": {
          "from_local_id": {
            "type": "string",
            "description": "References local_id from items array (for new items) or existing_elem_id value"
          },
          "to_local_id": {
            "type": "string",
            "description": "References local_id from items array (for new items) or existing_elem_id value"
          },
          "relation_type": {
            "type": "string",
            "enum": ["DEPENDS_ON", "REFINES", "CONTRADICTS", "OVERLAPS", "IMPLEMENTS"]
          },
          "evidence_atom_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ATOM-"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
