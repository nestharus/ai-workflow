{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskPlanOutput",
  "type": "object",
  "required": [
    "plan_id",
    "tasks"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "title",
          "status"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "target_lib_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target_elem_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_atom_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "dependency_graph": {
      "type": [
        "object",
        "null"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}