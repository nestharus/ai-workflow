# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly declare text files to normalize to LF
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.sh text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.xslt text eol=lf
*.xsd text eol=lf
*.csv text eol=lf
*.properties text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.whl binary
