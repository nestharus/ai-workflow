#!/usr/bin/env bash
# Run Codex CLI - optionally with --yolo flag for bypassing sandboxing
#
# Usage:
#   ./codex [args...]           - Run with sandboxing enabled (safe mode)
#   ./codex --yolo [args...]    - Explicitly bypass sandboxing (dangerous)
#   CODEX_YOLO=1 ./codex [args...] - Bypass sandboxing via environment variable
#
# WARNING: The --yolo flag bypasses all sandboxing and approval prompts.
#          Only use this when you fully trust the operations being performed.

# Check if user explicitly passed --yolo or set CODEX_YOLO environment variable
if [[ " $* " == *" --yolo "* ]] || [[ "${CODEX_YOLO:-}" == "1" ]]; then
    if [[ "${CODEX_YOLO:-}" == "1" ]] && [[ " $* " != *" --yolo "* ]]; then
        echo "WARNING: Running with --yolo flag (CODEX_YOLO=1). Sandboxing bypassed." >&2
        codex --yolo "$@"
    else
        # User explicitly passed --yolo, forward as-is
        codex "$@"
    fi
else
    # Safe mode: no --yolo flag
    codex "$@"
fi
