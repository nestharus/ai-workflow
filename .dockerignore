# Ignore everything by default
*

# Include application code
!app/
!app/**

# Include production scripts only
!scripts/__init__.py
!scripts/app/
!scripts/app/**

# Include dependency files
!pyproject.toml
!uv.lock
!README.md
!LICENSE

# Exclude Python bytecode everywhere
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.py[cod]
