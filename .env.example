# =============================================================================
# AI Workflow Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required values are marked with "Required" - the application will not start
# without them. All other values have sensible defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

APP_NAME="AI Workflow API"
APP_VERSION=0.1.0
DEBUG=false
HOST=127.0.0.1
INCLUDE_ERROR_BODY=false
PORT=8000

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

API_PREFIX=/api/v1
EXAMPLE_PREFIX=[PROCESSED]

# -----------------------------------------------------------------------------
# AI API Keys
# -----------------------------------------------------------------------------
# Note: Anthropic, OpenAI, and Google use OAuth authentication

FIRECRAWL_API_KEY=your-firecrawl-api-key-here
MINIMAX_API_KEY=your-minimax-api-key-here
Z_API_KEY=your-zhipu-glm-api-key-here

# -----------------------------------------------------------------------------
# Linear Integration (for ticket management)
# -----------------------------------------------------------------------------

LINEAR_API_KEY=your-linear-api-key-here
LINEAR_TEAM_ID=your-team-id

# -----------------------------------------------------------------------------
# GitHub Integration
# -----------------------------------------------------------------------------

GITHUB_MCP_PAT=your-github-mcp-pat-here
GITHUB_REPO=owner/repo
GITHUB_TOKEN=your-github-token-here

# -----------------------------------------------------------------------------
# SonarQube Integration (optional)
# -----------------------------------------------------------------------------

SONAR_PROJECT_KEY=your-project-key
SONAR_TOKEN=your-sonar-token-here
SONAR_URL=https://sonarcloud.io

# -----------------------------------------------------------------------------
# OpenCode Configuration
# -----------------------------------------------------------------------------

OPENCODE_EXPERIMENTAL_BASH_DEFAULT_TIMEOUT_MS=300000

# -----------------------------------------------------------------------------
# Database Configuration (SurrealDB)
# -----------------------------------------------------------------------------
# Username and password must be at least 12 characters with complexity

SURREALDB_DATABASE=facts
SURREALDB_NAMESPACE=knowledge
SURREALDB_PASS=your-password-min-12-chars
SURREALDB_POOL_SIZE=5
SURREALDB_URL=ws://localhost:8000/rpc
SURREALDB_USER=your-username-min-12-chars

# -----------------------------------------------------------------------------
# Vector Search (Elasticsearch)
# -----------------------------------------------------------------------------

ELASTICSEARCH_CONNECTIONS_PER_NODE=25
ELASTICSEARCH_REPLICAS=0
ELASTICSEARCH_REQUEST_TIMEOUT=10
ELASTICSEARCH_SHARDS=1
ELASTICSEARCH_URL=http://localhost:9200
EMBEDDING_DIMENSION=768

# -----------------------------------------------------------------------------
# Middleware Settings
# -----------------------------------------------------------------------------

ALLOWED_HOSTS=[*]
ENABLE_GZIP=false
ENFORCE_HTTPS=false

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------

CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_HEADERS=[*]
CORS_ALLOW_METHODS=[*]
CORS_ALLOW_ORIGINS=[]
CORS_ALLOW_ORIGIN_REGEX=
CORS_ENABLED=false
CORS_EXPOSE_HEADERS=[]
CORS_MAX_AGE=600
