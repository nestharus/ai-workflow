[
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "connection-pooling-fundamentals",
    "origin_type": "original",
    "original_text": "Core principles for creating and managing pooled connections in a FastAPI application. | Connection pooling fundamentals",
    "splits": [
      {
        "split_text": "Core principles for creating and managing pooled connections in Python applications. | Connection pooling fundamentals",
        "source_file": "docs/development/python/python.connection-pooling-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "fundamentals.startup-only",
    "origin_type": "original",
    "original_text": "Create connection pools and long-lived clients only once during application startup, before the app begins handling requests.",
    "splits": [
      {
        "split_text": "Create connection pools and long-lived clients only once during application startup, before handling requests or processing tasks.",
        "source_file": "docs/development/python/python.connection-pooling-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "fundamentals.no-per-request",
    "origin_type": "original",
    "original_text": "Never create database engines, SurrealDB pools, Elasticsearch clients, or HTTP clients inside route handlers or other per-request code paths.",
    "splits": [
      {
        "split_text": "Never create database pools, search clients, or HTTP clients inside per-request code paths; pool creation is expensive and leaks resources.",
        "source_file": "docs/development/python/python.connection-pooling-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "fundamentals.shared-state",
    "origin_type": "original",
    "original_text": "Store shared resources on app.state (for example app.state.surrealdb_pool, app.state.elasticsearch_client, app.state.http_client) so they can be accessed via dependencies rather than globals.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "fundamentals.lifespan-managed",
    "origin_type": "original",
    "original_text": "Use the lifespan context manager in app/core/factory.py to initialize pools during startup and close them during shutdown, guaranteeing cleanup even if initialization fails.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "fundamentals.access-via-deps",
    "origin_type": "original",
    "original_text": "Access pools and clients through dependency providers (for example get_surrealdb_pool, get_elasticsearch_client) so tests can override them easily.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "surreal.lifecycle.startup",
    "origin_type": "original",
    "original_text": "In lifespan startup, call create_surrealdb_pool(settings) to build a SurrealDBPool, initialize connections, and attach it to app.state.surrealdb_pool.",
    "splits": [
      {
        "split_text": "Call create_surrealdb_pool(settings) during startup to build a SurrealDBPool, initialize connections, and make it available for dependency injection.",
        "source_file": "docs/development/surrealdb/surrealdb.connection-pooling-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "es.wrapper-role",
    "origin_type": "original",
    "original_text": "Use ElasticsearchWrapper in app/infrastructure/db_connections.py to adapt the synchronous elasticsearch client for async use and centralize connection management.",
    "splits": [
      {
        "split_text": "Use ElasticsearchWrapper in app/infrastructure/elasticsearch/client.py to adapt the synchronous elasticsearch client for async use and centralize connection management.",
        "source_file": "docs/development/elasticsearch/elasticsearch.connection-pooling-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "es.client-managed-pool",
    "origin_type": "original",
    "original_text": "Rely on the Elasticsearch client\u2019s internal HTTP connection pool, configured via Settings.elasticsearch_connections_per_node.",
    "splits": [
      {
        "split_text": "Rely on the Elasticsearch client's internal HTTP connection pool, configured via Settings.elasticsearch_connections_per_node.",
        "source_file": "docs/development/elasticsearch/elasticsearch.connection-pooling-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "es.index-initialization",
    "origin_type": "original",
    "original_text": "Use initialize_indices() on the wrapper to create required indices with configured shard and replica counts, handling already-existing indices gracefully.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "tuning.conservative-defaults",
    "origin_type": "original",
    "original_text": "Start with small pool sizes (for example 5\u201310 connections per pool or per node) instead of guessing large values.",
    "splits": [
      {
        "split_text": "Start with small pool sizes (for example 5-10 connections per pool or per node) instead of guessing large values; premature optimization wastes resources.",
        "source_file": "docs/development/python/python.connection-pooling-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "tuning.respect-backend-limits",
    "origin_type": "original",
    "original_text": "Ensure workers \u00d7 surrealdb_pool_size and similar calculations stay well below backend connection limits.",
    "splits": [
      {
        "split_text": "Ensure workers multiplied by pool size stays well below backend connection limits to avoid resource exhaustion on the database or search cluster.",
        "source_file": "docs/development/python/python.connection-pooling-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "tuning.observe-metrics",
    "origin_type": "original",
    "original_text": "Monitor metrics such as acquire timeouts, queue wait times, request latencies, and error rates before changing pool sizes.",
    "splits": [
      {
        "split_text": "Monitor metrics such as acquire timeouts, queue wait times, request latencies, and error rates before changing pool sizes; data-driven tuning outperforms guesswork.",
        "source_file": "docs/development/python/python.connection-pooling-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "tuning.scale-incrementally",
    "origin_type": "original",
    "original_text": "Increase pool sizes gradually and evaluate impact, preferring query optimization and caching where they provide better benefits than simply adding connections.",
    "splits": [
      {
        "split_text": "Increase pool sizes gradually and evaluate impact; prefer query optimization and caching where they provide better benefits than simply adding connections.",
        "source_file": "docs/development/python/python.connection-pooling-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "timeouts.acquire",
    "origin_type": "original",
    "original_text": "Use SurrealDBPool.acquire() with asyncio.wait_for to enforce acquire timeouts and log when callers cannot obtain connections within the configured window.",
    "splits": [
      {
        "split_text": "Use asyncio.wait_for or equivalent mechanisms to enforce acquire timeouts; log when callers cannot obtain connections within the configured window.",
        "source_file": "docs/development/python/python.connection-pooling-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "timeouts.request",
    "origin_type": "original",
    "original_text": "Bound Elasticsearch operations with elasticsearch_request_timeout and similarly configured HTTP client timeouts.",
    "splits": [
      {
        "split_text": "Bound operations with request-level timeouts to prevent hanging when backends are slow or unreachable.",
        "source_file": "docs/development/python/python.connection-pooling-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "timeouts.logging-alerts",
    "origin_type": "original",
    "original_text": "Treat repeated timeouts as indicators of pool exhaustion or backend slowness and investigate query patterns, indexing, and infrastructure before simply raising pool sizes.",
    "splits": [
      {
        "split_text": "Treat repeated timeouts as indicators of pool exhaustion or backend slowness; investigate query patterns, indexing, and infrastructure before simply raising pool sizes.",
        "source_file": "docs/development/python/python.connection-pooling-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.connection-pooling-patterns.yml",
    "id": "timeouts.fail-fast",
    "origin_type": "original",
    "original_text": "Translate timeout failures into well-typed exceptions that global handlers can convert into HTTP errors rather than allowing requests to hang.",
    "splits": [
      {
        "split_text": "Translate timeout failures into well-typed exceptions so callers and exception handlers can convert them into appropriate error responses.",
