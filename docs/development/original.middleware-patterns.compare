[
  {
    "source_file": "docs/development/original.middleware-patterns.yml",
    "id": "middleware-fundamentals-ordering",
    "origin_type": "original",
    "original_text": "Explains ASGI middleware semantics, stack behavior, and why middleware is the correct place for cross-cutting concerns. | Middleware Fundamentals and Ordering",
    "splits": []
  },
  {
    "source_file": "docs/development/original.middleware-patterns.yml",
    "id": "mw.role-cross-cutting",
    "origin_type": "original",
    "original_text": "Use HTTP middleware only for cross-cutting concerns that must run on every request and response (security headers, compression, logging, metrics, request IDs, rate limiting); do not implement business logic in middleware.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.middleware-patterns.yml",
    "id": "mw.stack-behavior",
    "origin_type": "original",
    "original_text": "Middleware is applied as a stack via app.add_middleware; the last-added middleware becomes the outermost wrapper, so it runs first on the request path and last on the response path.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.middleware-patterns.yml",
    "id": "mw.flow-example",
    "origin_type": "original",
    "original_text": "If MiddlewareA is added first and MiddlewareB second, the request flow is MiddlewareB \u2192 MiddlewareA \u2192 route handler, and the response flow is route handler \u2192 MiddlewareA \u2192 MiddlewareB.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.middleware-patterns.yml",
    "id": "mw.registration-location",
    "origin_type": "original",
    "original_text": "Register all HTTP middleware from create_app in app/core/factory.py using app.add_middleware; do not wrap the ASGI app manually or add middleware from scattered modules.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.middleware-patterns.yml",
    "id": "mw.ordering-critical",
    "origin_type": "original",
    "original_text": "Decide the desired request-path execution order first, then register inner middleware earlier and outer middleware later so critical concerns like security and host validation always run.",
    "splits": []
  },
  {
