  },
  {
    "source_file": "docs/development/original.exception-patterns.yml",
    "id": "domain.extensibility",
    "origin_type": "original",
    "original_text": "Define additional DomainError subclasses (such as UserNotFoundError or InvalidOrderStateError) to express more precise codes without leaking HTTP concerns.",
