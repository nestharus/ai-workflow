        text: "Apply when: Understanding ASGI middleware concepts, implementing custom middleware classes, or designing cross-cutting concerns."
      - id: middleware-patterns-fastapi.file
        type: reference
        text: "File: fastapi/middleware-patterns.toon"
      - id: middleware-patterns-fastapi.description
        type: note
