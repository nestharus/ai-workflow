        text: "File: surrealdb/repository-patterns.toon"
      - id: repository-patterns-surrealdb.description
        type: note
        text: SurrealDB-specific patterns including pool usage, parameterized queries, schema operations, and result mapping.
      - id: repository-patterns-surrealdb.apply-when
        type: guidance
        text: "Apply when: Implementing SurrealDB repositories, writing queries, or managing connections."
      - id: repository-patterns-elasticsearch.file
        type: reference
        text: "File: elasticsearch/repository-patterns.toon"
      - id: repository-patterns-elasticsearch.description
        type: note
        text: Elasticsearch-specific patterns including search queries, indexing operations, bulk operations, and index management.
      - id: repository-patterns-elasticsearch.apply-when
        type: guidance
        text: "Apply when: Implementing search repositories, building queries, or managing indices."
  - id: middleware-patterns
    index: 7
    title: Middleware Patterns
    category: navigation
    summary: Covers HTTP middleware implementation, ordering, and configuration for cross-cutting concerns.
    items[6]:
      - id: middleware-patterns-python.file
        type: reference
        text: "File: python/middleware-patterns.toon"
      - id: middleware-patterns-python.description
        type: note
        text: Covers ASGI middleware fundamentals, stack behavior, implementation patterns, and cross-cutting concern design.
      - id: middleware-patterns-python.apply-when
