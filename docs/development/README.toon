sections[12]:
  - id: settings-patterns
    index: 1
    title: Settings Patterns
    category: navigation
    summary: Defines how to model, validate, and consume runtime configuration using Pydantic settings and FastAPI dependency injection.
    items[6]:
      - id: settings-patterns-python.file
        type: reference
        text: "File: python/settings-patterns.toon"
      - id: settings-patterns-python.description
        type: note
        text: Covers Pydantic BaseSettings usage, field validation, credential security, environment variable mapping, and testing patterns.
      - id: settings-patterns-python.apply-when
        type: guidance
        text: "Apply when: Defining Settings fields, adding validators, or structuring configuration models."
      - id: settings-patterns-fastapi.file
        type: reference
        text: "File: fastapi/settings-patterns.toon"
      - id: settings-patterns-fastapi.description
        type: note
        text: Covers Settings DI integration, get_settings dependency, app.state storage, and runtime access patterns.
      - id: settings-patterns-fastapi.apply-when
        type: guidance
        text: "Apply when: Integrating Settings with FastAPI factory, injecting Settings into routers, or testing with dependency overrides."
  - id: factory-patterns
    index: 2
    title: Factory Patterns
    category: navigation
    summary: Covers application construction, lifespan management, and configuration patterns for building applications.
    items[6]:
      - id: factory-patterns-python.file
        type: reference
        text: "File: python/factory-patterns.toon"
      - id: factory-patterns-python.description
        type: note
        text: Covers generic Python factory functions, resource initialization patterns, dependency composition, and factory testing strategies.
      - id: factory-patterns-python.apply-when
        type: guidance
        text: "Apply when: Designing factory functions, implementing resource initialization with cleanup, or composing dependency graphs."
      - id: factory-patterns-fastapi.file
        type: reference
        text: "File: fastapi/factory-patterns.toon"
      - id: factory-patterns-fastapi.description
        type: note
        text: Covers FastAPI create_app pattern, lifespan context managers, middleware and router registration, and OpenAPI customization.
      - id: factory-patterns-fastapi.apply-when
        type: guidance
        text: "Apply when: Setting up FastAPI application entry points, configuring lifespan events, or wiring middleware and routers."
  - id: dependency-patterns
    index: 3
    title: Dependency Patterns
    category: navigation
    summary: Establishes dependency injection patterns using Python constructor injection and FastAPI's Depends() system.
    items[6]:
      - id: dependency-patterns-python.file
        type: reference
        text: "File: python/dependency-patterns.toon"
      - id: dependency-patterns-python.description
        type: note
        text: Covers constructor injection, factory functions, service layer patterns, and lifecycle concepts.
      - id: dependency-patterns-python.apply-when
        type: guidance
        text: "Apply when: Designing service constructors, creating factory functions, or understanding dependency lifecycles."
      - id: dependency-patterns-fastapi.file
        type: reference
        text: "File: fastapi/dependency-patterns.toon"
      - id: dependency-patterns-fastapi.description
        type: note
        text: Covers FastAPI Depends(), Annotated type aliases, yield-based dependencies, and app.dependency_overrides.
      - id: dependency-patterns-fastapi.apply-when
        type: guidance
        text: "Apply when: Creating injectable dependencies, defining Annotated type aliases, or testing with dependency overrides."
  - id: router-patterns
    index: 4
    title: Router Patterns
    category: navigation
    summary: Defines route handler structure and FastAPI router organization for building consistent API endpoints.
    items[6]:
      - id: router-patterns-python.file
        type: reference
        text: "File: python/router-patterns.toon"
      - id: router-patterns-python.description
        type: note
        text: Covers thin handler principles, service delegation patterns, handler responsibilities, and error propagation.
      - id: router-patterns-python.apply-when
        type: guidance
        text: "Apply when: Designing handler structure, understanding service delegation, or implementing error handling in handlers."
      - id: router-patterns-fastapi.file
        type: reference
        text: "File: fastapi/router-patterns.toon"
      - id: router-patterns-fastapi.description
        type: note
        text: Covers APIRouter organization, dependency injection with Depends(), request validation, response_model configuration, and OpenAPI documentation.
      - id: router-patterns-fastapi.apply-when
        type: guidance
        text: "Apply when: Creating FastAPI endpoints, configuring routers, injecting dependencies, or documenting routes in OpenAPI."
  - id: service-patterns
    index: 5
    title: Service Layer Patterns
    category: navigation
    summary: Establishes service layer architecture for encapsulating business logic and transaction management.
    items[6]:
      - id: service-patterns-python.file
        type: reference
        text: "File: python/service-patterns.toon"
      - id: service-patterns-python.description
        type: note
        text: Framework-agnostic service layer concepts including responsibilities, class structure, constructor injection, transaction management, domain errors, testing, and lifecycle.
      - id: service-patterns-python.apply-when
        type: guidance
        text: "Apply when: Designing service classes, implementing business logic, managing transactions, or understanding service responsibilities."
      - id: service-patterns-fastapi.file
        type: reference
        text: "File: fastapi/service-patterns.toon"
      - id: service-patterns-fastapi.description
        type: note
        text: FastAPI-specific service integration including factory dependencies, Depends() usage, app.state integration, and testing with overrides.
      - id: service-patterns-fastapi.apply-when
        type: guidance
        text: "Apply when: Wiring services into FastAPI routers, creating service factories, or testing with dependency overrides."
  - id: repository-patterns
    index: 6
    title: Repository Layer Patterns
    category: navigation
    summary: Defines data access layer patterns, repository interfaces, and query patterns for persistence code.
    items[9]:
      - id: repository-patterns-python.file
        type: reference
        text: "File: python/repository-patterns.toon"
      - id: repository-patterns-python.description
        type: note
        text: Framework-agnostic repository patterns including responsibilities, Protocol interfaces, implementation classes, transaction management, query patterns, error handling, testing, and anti-patterns.
      - id: repository-patterns-python.apply-when
        type: guidance
        text: "Apply when: Designing repository interfaces, implementing CRUD operations, or understanding repository responsibilities."
      - id: repository-patterns-surrealdb.file
