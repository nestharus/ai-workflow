[
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "overview.layers",
    "origin_type": "original",
    "original_text": "The application is organized into four primary layers: Routers (HTTP), Services (business logic), Repositories (data access), and Contracts/DTOs (data structures).",
    "splits": [
      {
        "split_text": "The application is organized into four primary layers: Handlers/Presentation (HTTP or other transport), Services (business logic), Repositories (data access), and Contracts/DTOs (data structures).",
        "source_file": "docs/development/python/python.architectural-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "overview.call-direction",
    "origin_type": "original",
    "original_text": "Allowed call direction is strictly downward: Routers -> Services -> Repositories. Upper layers may depend on lower layers, but never the reverse.",
    "splits": [
      {
        "split_text": "Allowed call direction is strictly downward: Handlers -> Services -> Repositories. Upper layers may depend on lower layers, but never the reverse.",
        "source_file": "docs/development/python/python.architectural-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "overview.no-skip-layers",
    "origin_type": "original",
    "original_text": "Routers must not call repositories directly; all data access must go through services to maintain business logic centralization.",
    "splits": [
      {
        "split_text": "Handlers must not call repositories directly; all data access must go through services to maintain business logic centralization.",
        "source_file": "docs/development/python/python.architectural-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "overview.http-boundary",
    "origin_type": "original",
    "original_text": "Only routers handle HTTP concerns (status codes, headers, request/response objects); services and repositories are HTTP-agnostic.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "overview.di-wiring",
    "origin_type": "original",
    "original_text": "Dependencies flow via constructor injection; the application factory in app/core/factory.py wires infrastructure (pools, wrappers) into repositories and services.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "request-lifecycle",
    "origin_type": "original",
    "original_text": "Describes the flow of a typical HTTP request through all architectural layers. | Typical request lifecycle",
    "splits": [
      {
        "split_text": "Describes the generic flow of a request through all architectural layers. | Request lifecycle concepts",
        "source_file": "docs/development/python/python.architectural-patterns.yml"
      },
      {
        "split_text": "Describes the detailed flow of an HTTP request through FastAPI layers including middleware processing. | FastAPI request lifecycle",
        "source_file": "docs/development/fastapi/fastapi.architectural-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "lifecycle.step1",
    "origin_type": "original",
    "original_text": "1. Request arrives at FastAPI; middleware (logging, security headers, error handling) processes it first.",
    "splits": [
      {
        "split_text": "1. Request arrives at the application; framework-level processing (validation, authentication) occurs first.",
        "source_file": "docs/development/python/python.architectural-patterns.yml"
      },
      {
        "split_text": "1. Request arrives at FastAPI; middleware stack processes it first (logging, security headers, error handling).",
        "source_file": "docs/development/fastapi/fastapi.architectural-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "lifecycle.step2",
    "origin_type": "original",
    "original_text": "2. FastAPI matches the route and invokes the router handler with validated path/query/body parameters.",
    "splits": [
      {
        "split_text": "2. Handler receives validated input and constructs contract DTOs for service method arguments.",
        "source_file": "docs/development/python/python.architectural-patterns.yml"
      },
      {
        "split_text": "2. FastAPI matches the route and invokes validation on path/query/body parameters.",
        "source_file": "docs/development/fastapi/fastapi.architectural-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "lifecycle.step3",
    "origin_type": "original",
    "original_text": "3. Router handler uses Depends() to obtain service instances (constructed with injected repositories).",
    "splits": [
      {
        "split_text": "3. Handler calls service method(s), passing validated contract DTOs.",
        "source_file": "docs/development/python/python.architectural-patterns.yml"
      },
      {
        "split_text": "3. Router handler executes with Depends() resolving service instances (constructed with injected repositories).",
        "source_file": "docs/development/fastapi/fastapi.architectural-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "lifecycle.step8",
    "origin_type": "original",
    "original_text": "8. FastAPI serializes response; middleware processes outgoing response (compression, headers).",
    "splits": [
      {
        "split_text": "8. FastAPI serializes response; middleware stack processes outgoing response (compression, headers).",
        "source_file": "docs/development/fastapi/fastapi.architectural-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "routers-layer",
    "origin_type": "original",
    "original_text": "Handle HTTP request/response lifecycle using APIRouter instances registered in app/core/factory.py. See app/routes/example_router.py for a reference implementation. | Routers layer",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "routers.role",
    "origin_type": "original",
    "original_text": "Handle HTTP request/response lifecycle exclusively; routers are the entry point for HTTP concerns.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "routers.pattern",
    "origin_type": "original",
    "original_text": "Use APIRouter instances registered in app/core/factory.py; never attach routes directly to the app object.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "routers.no-business-logic",
    "origin_type": "original",
    "original_text": "No business logic in routers; delegate all processing to the service layer.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "routers.response-model",
    "origin_type": "original",
    "original_text": "Use Pydantic models for response_model and include summary, description, and responses for OpenAPI documentation.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "routers.error-handling",
    "origin_type": "original",
    "original_text": "Let services raise domain exceptions; global exception handlers (registered in factory) translate them to HTTP responses.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "routers.dependencies",
    "origin_type": "original",
    "original_text": "Use FastAPI Depends() with Annotated type aliases to inject services; routers should not construct services directly.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "services-layer",
    "origin_type": "original",
    "original_text": "Encapsulate business logic with class-based services and dependency injection. See app/services/example_service.py for a reference implementation. | Services layer",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "services.role",
    "origin_type": "original",
    "original_text": "Encapsulate all business logic; services are the heart of the application.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "services.pattern",
    "origin_type": "original",
    "original_text": "Implement services as classes with constructor-based dependency injection.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "services.lifecycle.init",
    "origin_type": "original",
    "original_text": "Use __init__ to initialize dependencies explicitly via constructor parameters.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "services.lifecycle.process",
    "origin_type": "original",
    "original_text": "Implement core logic in named methods representing business actions (verbs like create, process, calculate).",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "services.lifecycle.shutdown",
    "origin_type": "original",
    "original_text": "Provide an optional shutdown() method for cleanup of resources when needed.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "services.orchestration",
    "origin_type": "original",
    "original_text": "Services may call multiple repositories and external clients; they own transaction boundaries and coordinate units of work.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "services.domain-errors",
    "origin_type": "original",
    "original_text": "Raise domain-specific exceptions (from app/core/errors.py) rather than HTTP exceptions; see exception-patterns.md for the error hierarchy.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "repositories-layer",
    "origin_type": "original",
    "original_text": "Provide storage-agnostic data access abstraction over SurrealDB, Elasticsearch, and future stores. See app/repositories/example_repository.py for a reference implementation. | Repositories layer",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "repositories.role",
    "origin_type": "original",
    "original_text": "Encapsulate all direct database and search index interactions; hide storage details behind stable Python interfaces.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "repositories.pattern",
    "origin_type": "original",
    "original_text": "Define repository protocols (typing.Protocol) and implement concrete classes that accept connection pools via constructor.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "repositories.domain-mapping",
    "origin_type": "original",
    "original_text": "Return domain models or DTOs (Pydantic models from app/contracts/), not raw database rows or driver-specific structures.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "repositories.no-transactions",
    "origin_type": "original",
    "original_text": "Repositories must not commit or roll back transactions; transaction boundaries are owned by services.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "repositories.http-agnostic",
    "origin_type": "original",
    "original_text": "Repositories never import FastAPI or raise HTTP exceptions; they are unaware of the transport layer.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "repositories.testability",
    "origin_type": "original",
    "original_text": "Repository protocols enable easy substitution with fakes or mocks for service unit testing.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "contracts-layer",
    "origin_type": "original",
    "original_text": "Define data structures and validation rules using Pydantic models with strict configuration. See app/contracts/example_contract.py for a reference implementation. | Contracts and DTOs layer",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "contracts.role",
    "origin_type": "original",
    "original_text": "Define data structures and validation rules for request/response payloads and internal data transfer.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "contracts.pattern",
    "origin_type": "original",
    "original_text": "Use Pydantic models with strict configuration (ConfigDict) for all contracts.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "contracts.extra-forbid",
    "origin_type": "original",
    "original_text": "Always set ConfigDict(extra=\"forbid\") to reject unknown fields in JSON payloads.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "contracts.validation",
    "origin_type": "original",
    "original_text": "Use Annotated and Field for validation constraints; define custom validators (@model_validator) for complex logic.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "contracts.shared",
    "origin_type": "original",
    "original_text": "Contracts are shared across layers; routers use them for request/response, services for internal transfer, repositories for domain models.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "cross-cutting-concerns",
    "origin_type": "original",
    "original_text": "Middleware and exception handling span all layers and are configured in the application factory. | Cross-cutting concerns",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "crosscutting.middleware",
    "origin_type": "original",
    "original_text": "Middleware (logging, security headers, compression) is registered in app/core/factory.py and processes requests before routers and responses after serialization. See middleware-patterns.md.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "crosscutting.exception-handlers",
    "origin_type": "original",
    "original_text": "Global exception handlers translate domain errors to HTTP responses; they are registered in the application factory and documented in exception-patterns.md.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "crosscutting.lifespan",
    "origin_type": "original",
    "original_text": "Application lifespan events (startup/shutdown) initialize and clean up infrastructure resources (connection pools, search clients) in app/core/factory.py.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "crosscutting.settings",
    "origin_type": "original",
    "original_text": "Configuration flows from a single Settings instance created at startup; it is injected into services and infrastructure via dependency injection.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.architectural-patterns.yml",
    "id": "crosscutting.health-checks",
    "origin_type": "original",
    "original_text": "Health endpoints (/health for liveness, /api/v1/health for readiness) are registered separately from domain routers and documented in api-patterns.toon.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "overview.transport-boundary",
    "origin_type": "split_only",
    "source_text": "Only handlers handle transport concerns (HTTP status codes, headers, request/response objects, message queue acknowledgments); services and repositories are transport-agnostic.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "overview.di-flow",
    "origin_type": "split_only",
    "source_text": "Dependencies flow via constructor injection; infrastructure resources (pools, clients) are created at application startup and injected into repositories and services.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "layer-responsibilities",
    "origin_type": "split_only",
    "source_text": "Each layer has distinct responsibilities that must not leak into other layers. | Layer responsibilities",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "responsibilities.handlers",
    "origin_type": "split_only",
    "source_text": "Handlers/Presentation Layer: Handle request/response lifecycle, validate input using framework mechanisms, delegate all processing to services, return response models.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "responsibilities.handlers-no-logic",
    "origin_type": "split_only",
    "source_text": "Handlers contain no business logic; they are thin wrappers that translate transport input to service calls and service output to transport responses.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "responsibilities.services",
    "origin_type": "split_only",
    "source_text": "Services Layer: Encapsulate business logic, orchestrate repository calls, define transaction boundaries, raise domain-specific exceptions, remain transport-agnostic.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "responsibilities.services-coordination",
    "origin_type": "split_only",
    "source_text": "Services may call multiple repositories and external clients; they own units of work and coordinate complex operations across data stores.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "responsibilities.repositories",
    "origin_type": "split_only",
    "source_text": "Repositories Layer: Encapsulate data access, hide storage implementation details, return domain models, never commit or roll back transactions.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "responsibilities.repositories-abstraction",
    "origin_type": "split_only",
    "source_text": "Repository protocols (typing.Protocol) enable substitution with fakes or mocks for service unit testing.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "responsibilities.contracts",
    "origin_type": "split_only",
    "source_text": "Contracts/DTOs Layer: Define data structures and validation rules shared across layers using Pydantic models.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "responsibilities.contracts-validation",
    "origin_type": "split_only",
    "source_text": "Use strict Pydantic configuration (ConfigDict with extra=\"forbid\") to reject unknown fields and enforce data integrity.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "dependency-flow",
    "origin_type": "split_only",
    "source_text": "Dependencies flow downward via constructor injection, enabling testability and explicit composition. | Dependency flow and injection principles",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "di.constructor-injection",
    "origin_type": "split_only",
    "source_text": "Dependencies flow via constructor injection; services receive repositories via constructors, handlers receive services via framework DI mechanisms.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "di.infrastructure",
    "origin_type": "split_only",
    "source_text": "Infrastructure resources (connection pools, HTTP clients) are created at application startup and injected into repositories or services as constructor arguments.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "di.factory-functions",
    "origin_type": "split_only",
    "source_text": "Factory functions compose dependencies, constructing services with their required repositories and configuration.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "di.no-globals",
    "origin_type": "split_only",
    "source_text": "Avoid module-level global state; all dependencies should be explicitly passed through constructors or factory functions.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "di.testability",
    "origin_type": "split_only",
    "source_text": "Each layer can be tested in isolation by mocking the layer below; services mock repositories, handlers mock services.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "di.lifecycle",
    "origin_type": "split_only",
    "source_text": "Resource lifecycle (initialization, cleanup) is managed by the application factory or lifespan manager, not by individual services or repositories.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "anti-patterns",
    "origin_type": "split_only",
    "source_text": "Common pitfalls that undermine layered architecture design. | Anti-patterns",
    "splits": []
  },
  {
    "source_file": "docs/development/fastapi/fastapi.architectural-patterns.yml",
    "id": "anti-patterns",
    "origin_type": "split_only",
    "source_text": "FastAPI-specific pitfalls that undermine layered architecture integration. | Anti-patterns",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "anti.layer-skipping",
    "origin_type": "split_only",
    "source_text": "Layer skipping (handlers calling repositories directly) bypasses business logic centralization and makes testing harder.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "anti.logic-in-handlers",
    "origin_type": "split_only",
    "source_text": "Business logic in handlers violates separation of concerns and makes logic harder to reuse and test.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "anti.transport-in-services",
    "origin_type": "split_only",
    "source_text": "HTTP or transport concerns in services or repositories couples them to specific frameworks and prevents reuse.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "anti.global-state",
    "origin_type": "split_only",
    "source_text": "Global state instead of dependency injection hides dependencies and makes testing unreliable.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "anti.mixed-responsibilities",
    "origin_type": "split_only",
    "source_text": "Mixed responsibilities within a single layer (e.g., services handling HTTP exceptions) violates single responsibility principle.",
    "splits": []
  },
  {
    "source_file": "docs/development/python/python.architectural-patterns.yml",
    "id": "anti.upward-dependencies",
    "origin_type": "split_only",
    "source_text": "Upward dependencies (repositories importing services, services importing handlers) create circular dependencies and coupling.",
    "splits": []
  },
  {
    "source_file": "docs/development/fastapi/fastapi.architectural-patterns.yml",
    "id": "router-integration",
    "origin_type": "split_only",
    "source_text": "APIRouter instances connect HTTP endpoints to services via FastAPI's dependency injection. | Router layer integration",
