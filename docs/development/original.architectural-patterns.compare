    "id": "router.no-business-logic",
    "origin_type": "split_only",
    "source_text": "No business logic in routers; delegate all processing to the service layer.",
    "splits": []
  },
  {
    "source_file": "docs/development/fastapi/fastapi.architectural-patterns.yml",
