    "source_file": "docs/development/original.repository-patterns.yml",
    "id": "testing.isolation",
    "origin_type": "original",
    "original_text": "Ensure test data is reset between runs by truncating collections, deleting indices, or using transactional rollbacks. See testing-patterns.md for concrete reset strategies.",
