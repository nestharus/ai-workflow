      }
    ]
  },
  {
    "source_file": "docs/development/original.repository-patterns.yml",
    "id": "testing.unit",
    "origin_type": "original",
    "original_text": "Replace SurrealDBPool or ElasticsearchWrapper with fakes or mocks that capture executed queries without performing real I/O. Assert on SQL strings, parameter dictionaries, or search bodies.",
    "splits": [
      {
        "split_text": "Replace pools or wrappers with fakes or mocks that capture executed queries without performing real I/O. Assert on query strings, parameter dictionaries, or search bodies.",
