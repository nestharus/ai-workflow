  {
    "source_file": "docs/development/original.repository-patterns.yml",
    "id": "responsibilities.persistence-abstraction",
    "origin_type": "original",
    "original_text": "Hide SurrealDB SQL, Elasticsearch queries, or future storage details behind a stable Python interface.",
    "splits": [
      {
        "split_text": "Hide database queries and search index operations behind a stable Python interface.",
        "source_file": "docs/development/python/python.repository-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.repository-patterns.yml",
    "id": "responsibilities.service-facing",
    "origin_type": "original",
    "original_text": "Services depend on repository interfaces, not on infrastructure classes like SurrealDBPool or ElasticsearchWrapper.",
    "splits": [
      {
        "split_text": "Services depend on repository interfaces, not on infrastructure classes like connection pools or client wrappers.",
        "source_file": "docs/development/python/python.repository-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.repository-patterns.yml",
    "id": "responsibilities.http-agnostic",
    "origin_type": "original",
    "original_text": "Repositories are unaware of HTTP; they never import FastAPI or raise HTTP-specific exceptions.",
    "splits": [
      {
        "split_text": "Repositories are unaware of HTTP; they never import web framework types or raise HTTP-specific exceptions.",
        "source_file": "docs/development/python/python.repository-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.repository-patterns.yml",
    "id": "responsibilities.architecture",
    "origin_type": "original",
    "original_text": "Modern FastAPI architectures pair repositories with a dedicated service layer; services compose multiple repositories and own business rules.",
    "splits": [
      {
        "split_text": "Modern architectures pair repositories with a dedicated service layer; services compose multiple repositories and own business rules.",
        "source_file": "docs/development/python/python.repository-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.repository-patterns.yml",
    "id": "interface.async",
    "origin_type": "original",
    "original_text": "Use async def for all I/O-bound operations so repositories compose naturally with async services and FastAPI routes.",
    "splits": [
      {
        "split_text": "Use async def for all I/O-bound operations so repositories compose naturally with async services.",
        "source_file": "docs/development/python/python.repository-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.repository-patterns.yml",
    "id": "interface.current-reference",
    "origin_type": "original",
    "original_text": "The repository pattern is illustrated in app/repositories/example_repository.py, where ExampleRepositoryProtocol is implemented against SurrealDBPool for save_processed_message. Services such as ExampleService in app/services/example_service.py depend on the protocol instead of the concrete pool, and API v1 wiring in app/api/v1/dependencies.py provides the repository via get_example_repository for service construction.",
    "splits": [
      {
        "split_text": "The repository pattern is illustrated in app/repositories/example_repository.py, where ExampleRepositoryProtocol is implemented. Services depend on the protocol instead of the concrete pool.",
        "source_file": "docs/development/python/python.repository-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.repository-patterns.yml",
    "id": "impl.constructor-injection",
    "origin_type": "original",
    "original_text": "Repository constructors accept minimal infrastructure dependencies (SurrealDBPool, ElasticsearchWrapper, AsyncSession); they do not reach into global application state.",
    "splits": [
      {
        "split_text": "Repository constructors accept minimal infrastructure dependencies (pool, wrapper, session); they do not reach into global application state.",
        "source_file": "docs/development/python/python.repository-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.repository-patterns.yml",
