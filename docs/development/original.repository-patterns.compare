  },
  {
    "source_file": "docs/development/original.repository-patterns.yml",
    "id": "txn.current-behavior",
    "origin_type": "original",
    "original_text": "With SurrealDB and Elasticsearch, each operation is effectively auto-committed. This document treats transaction boundaries as a service-level concern for architectural consistency.",
    "splits": [
      {
        "split_text": "With auto-commit stores, each operation is effectively committed immediately. This document treats transaction boundaries as a service-level concern for architectural consistency.",
        "source_file": "docs/development/python/python.repository-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.repository-patterns.yml",
    "id": "txn.cross-aggregate",
    "origin_type": "original",
    "original_text": "When a use case spans multiple repositories, the service layer coordinates all calls and defines recovery behavior if one step fails. See service-patterns.toon for orchestration details.",
    "splits": [
      {
        "split_text": "When a use case spans multiple repositories, the service layer coordinates all calls and defines recovery behavior if one step fails. See python/service-patterns.toon for orchestration details.",
        "source_file": "docs/development/python/python.repository-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.repository-patterns.yml",
    "id": "query.parameterized",
    "origin_type": "original",
    "original_text": "Always prefer parameterized queries ($id, $namespace, etc.) with separate parameter dictionaries to avoid injection and make queries reusable.",
    "splits": [
      {
        "split_text": "Always prefer parameterized queries with separate parameter dictionaries to avoid injection and make queries reusable.",
        "source_file": "docs/development/python/python.repository-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.repository-patterns.yml",
    "id": "query.domain-results",
    "origin_type": "original",
    "original_text": "Methods return lists of domain models, not raw database rows or Elasticsearch hits. Mapping is the repository's responsibility.",
    "splits": [
      {
        "split_text": "Methods return lists of domain models, not raw database rows or search hits. Mapping is the repository's responsibility.",
        "source_file": "docs/development/python/python.repository-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.repository-patterns.yml",
    "id": "query.bulk",
    "origin_type": "original",
    "original_text": "When the underlying store exposes efficient bulk APIs (e.g., Elasticsearch bulk), provide repository-level methods like bulk_index or bulk_insert.",
    "splits": [
      {
        "split_text": "When the underlying store exposes efficient bulk APIs, provide repository-level methods like bulk_index or bulk_insert.",
        "source_file": "docs/development/python/python.repository-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.repository-patterns.yml",
    "id": "errors.http-mapping",
    "origin_type": "original",
    "original_text": "Mapping domain exceptions to HTTP status codes and error payloads is the responsibility of exception-handling layer documented in exception-patterns.md and api-patterns.toon.",
    "splits": [
      {
        "split_text": "Mapping domain exceptions to HTTP status codes and error payloads is the responsibility of exception-handling layer documented in python/exception-patterns.toon and python/api-patterns.toon.",
