[
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "url.prefix",
    "origin_type": "original",
    "original_text": "Mount all versioned endpoints under /api/{version} (for example /api/v1) using create_app in app/core/factory.py.",
    "splits": [
      {
        "split_text": "Mount all versioned endpoints under /api/{version} (for example /api/v1) to support multiple API versions concurrently.",
        "source_file": "docs/development/python/python.api-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "url.health.liveness",
    "origin_type": "original",
    "original_text": "Expose GET /health as an unversioned liveness probe, exclude it from OpenAPI, and let orchestrators use it to check process aliveness.",
    "splits": [
      {
        "split_text": "Expose GET /health as an unversioned liveness probe for orchestrators to check process aliveness.",
        "source_file": "docs/development/python/python.api-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "url.health.readiness",
    "origin_type": "original",
    "original_text": "Expose GET /api/{version}/health as the versioned readiness endpoint, register it in the versioned API router, and document it in OpenAPI.",
    "splits": [
      {
        "split_text": "Expose GET /api/{version}/health as the versioned readiness endpoint to verify the application is ready to serve requests.",
        "source_file": "docs/development/python/python.api-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "url.trailing-slashes",
    "origin_type": "original",
    "original_text": "Declare canonical paths without a trailing slash (for example /users and /users/{user_id}); FastAPI handling of .../ redirects is not part of the API contract.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "http.status.named-constants",
    "origin_type": "original",
    "original_text": "Use fastapi.status named constants such as status.HTTP_201_CREATED instead of hard-coded integer literals.",
    "splits": [
      {
        "split_text": "Use named constants for HTTP status codes instead of hard-coded integer literals to improve code readability.",
        "source_file": "docs/development/python/python.api-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "http.validation.use-400",
    "origin_type": "original",
    "original_text": "Surface all request validation failures as HTTP 400 Bad Request instead of the FastAPI default 422 for RequestValidationError.",
    "splits": [
      {
        "split_text": "Surface all request validation failures as HTTP 400 Bad Request instead of framework defaults like 422.",
        "source_file": "docs/development/python/python.api-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "http.validation.handler-registration",
    "origin_type": "original",
    "original_text": "create_app registers validation_exception_handler from app/core/exceptions.py as the global handler for RequestValidationError.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "http.validation.error-model",
    "origin_type": "original",
    "original_text": "The validation exception handler returns a 400 response with an AppError envelope containing the HTTPValidationError payload in the details field. This ensures all error responses share the same top-level structure (code, message, statusCode, details).",
    "splits": [
      {
        "split_text": "Validation failures should return an AppError envelope containing field-level validation details. This ensures all error responses share the same top-level structure (code, message, statusCode, details).",
        "source_file": "docs/development/python/python.api-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "http.validation.route-responses",
    "origin_type": "original",
    "original_text": "Route decorators must reuse VALIDATION_ERROR_RESPONSE from app/contracts/errors.py in the responses mapping for 400 entries. This constant now references AppError for OpenAPI documentation consistency.",
    "splits": []
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "modeling.response-model-required",
    "origin_type": "original",
    "original_text": "Every endpoint must set response_model so that outbound schemas are enforced, extra fields from services are filtered out, and OpenAPI schemas are derived from the contracts.",
    "splits": [
      {
        "split_text": "Every endpoint must have an explicit response model so outbound schemas are enforced and extra fields from services are filtered out.",
        "source_file": "docs/development/python/python.api-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "modeling.describe-side-effects",
    "origin_type": "original",
    "original_text": "When a route has non-trivial side effects such as writes or external calls, the description must explain these behaviors for API consumers.",
    "splits": [
      {
        "split_text": "When a route has non-trivial side effects such as writes or external calls, document these behaviors for API consumers.",
        "source_file": "docs/development/python/python.api-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "openapi.errors.validation-contract",
    "origin_type": "original",
    "original_text": "For request validation errors, use VALIDATION_ERROR_RESPONSE to document a 400 response using the AppError envelope as the top-level error schema. The HTTPValidationError payload containing field-level validation details is nested inside AppError.details.",
    "splits": [
      {
        "split_text": "For request validation errors, use VALIDATION_ERROR_RESPONSE to document a 400 response using the AppError envelope as the top-level error schema.",
        "source_file": "docs/development/fastapi/fastapi.api-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "openapi.errors.do-not-duplicate-schemas",
    "origin_type": "original",
    "original_text": "Rely on create_app to register both the AppError schema (used for all error responses) and the HTTPValidationError schema (for the nested validation structure) in the OpenAPI schema; do not duplicate these schema definitions manually.",
    "splits": [
      {
        "split_text": "Rely on create_app to register both the AppError schema and the HTTPValidationError schema in the OpenAPI schema; do not duplicate these schema definitions manually.",
        "source_file": "docs/development/fastapi/fastapi.api-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "responses.no-generic-envelopes",
    "origin_type": "original",
    "original_text": "Do not wrap successful responses in generic envelopes such as {\"status\": \"ok\", \"data\": ...}; return the domain model dictated by response_model.",
    "splits": [
      {
        "split_text": "Do not wrap successful responses in generic envelopes such as {\"status\": \"ok\", \"data\": ...}; return the domain model directly.",
        "source_file": "docs/development/python/python.api-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "errors.app-error-envelope",
    "origin_type": "original",
    "original_text": "All error responses share a common top-level envelope using the AppError schema defined in app/contracts/errors.py with code, message, statusCode, and optional details fields.",
    "splits": [
      {
        "split_text": "All error responses share a common top-level envelope using the AppError schema with code, message, statusCode, and optional details fields.",
        "source_file": "docs/development/python/python.api-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "errors.validation-through-app-error",
    "origin_type": "original",
    "original_text": "Validation failures use the AppError envelope with code=\"VALIDATION_ERROR\" and the HTTPValidationError payload (containing field-level detail and optional body) placed in the details field. This provides a consistent top-level structure while preserving detailed validation information.",
    "splits": [
      {
        "split_text": "Validation failures use the AppError envelope with code=\"VALIDATION_ERROR\" and field-level details placed in the details field.",
        "source_file": "docs/development/python/python.api-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "errors.non-validation-through-app-error",
    "origin_type": "original",
    "original_text": "Non-validation errors such as domain or infrastructure failures use the AppError envelope with domain-specific code values (from the ErrorCode enum) and contextual details where applicable.",
    "splits": [
      {
        "split_text": "Non-validation errors such as domain or infrastructure failures use the AppError envelope with domain-specific code values and contextual details where applicable.",
        "source_file": "docs/development/python/python.api-patterns.yml"
      }
    ]
  },
  {
    "source_file": "docs/development/original.api-patterns.yml",
    "id": "errors.route-decorator-usage",
    "origin_type": "original",
    "original_text": "Route decorators use VALIDATION_ERROR_RESPONSE (which now references AppError) for 400 responses and {\"model\": AppError, \"description\": \"...\"} for other error status codes.",
    "splits": []
  },
