{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AtomsManifest",
  "type": "object",
  "required": [
    "file_uid",
    "rev_id",
    "atoms"
  ],
  "properties": {
    "file_uid": {
      "type": "string"
    },
    "rev_id": {
      "type": "string"
    },
    "atoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "atom_id",
          "line_no",
          "content"
        ],
        "properties": {
          "atom_id": {
            "type": "string"
          },
          "atom_fingerprint": {
            "type": "string"
          },
          "line_no": {
            "type": "integer",
            "minimum": 1
          },
          "content": {
            "type": "string"
          },
          "content_sha256": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}