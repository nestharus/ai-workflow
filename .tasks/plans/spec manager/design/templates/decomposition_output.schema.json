{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SurgicalDecompositionOutput",
  "type": "object",
  "required": [
    "root_fragment_id",
    "fragments",
    "operations",
    "coverage_ok"
  ],
  "properties": {
    "root_fragment_id": {
      "type": "string"
    },
    "fragments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "fragment_id",
          "atom_ids",
          "fragment_type",
          "children"
        ],
        "properties": {
          "fragment_id": {
            "type": "string"
          },
          "atom_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fragment_type": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "op_type",
          "target_fragment_id",
          "outputs",
          "confidence"
        ],
        "properties": {
          "op_type": {
            "type": "string"
          },
          "target_fragment_id": {
            "type": "string"
          },
          "outputs": {
            "type": "array"
          },
          "rationale": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": true
      }
    },
    "coverage_ok": {
      "type": "boolean"
    },
    "coverage_report": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true
}